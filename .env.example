# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
NETATLAS_SECRET_KEY=
NETATLAS_DB_PASSWORD=
# The first Admin, created on first start. Both can be removed from this file afterwards.
NETATLAS_ADMIN_USERNAME=
NETATLAS_ADMIN_PASSWORD=
# Comma-separated host names NetAtlas is reached under. Defaults to localhost,127.0.0.1.
# NETATLAS_ALLOWED_HOSTS=netatlas.example.com
NETATLAS_PORT=8000
# Largest Page attachment in MB. Defaults to 25.
# NETATLAS_MAX_ATTACHMENT_MB=25
# Login through an OIDC provider. See docs/oidc.md.
# NETATLAS_OIDC_ISSUER=https://auth.example.com/application/o/netatlas/
# NETATLAS_OIDC_CLIENT_ID=
# NETATLAS_OIDC_CLIENT_SECRET=
# NETATLAS_OIDC_PROVIDER_NAME=Authentik
# NETATLAS_OIDC_DEFAULT_ROLE=viewer
# NETATLAS_OIDC_ALLOWED_EMAIL_DOMAINS=example.com
# NETATLAS_OIDC_REDIRECT_URI=https://netatlas.example.com/login/oidc/callback/
